@model MedicMoveLogisticsMVC.Models.Client

@{
    ViewData["Title"] = "Create New Client";
}

<h1>Create</h1>
<h4>New Client</h4>

<div class="card tab" role="tabpanel">
    <div class="hd">
        <h2>Register New Client</h2>
        <span class="pill"><span class="dot"></span> Client Details</span>
    </div>
    <div class="bd">
        <form asp-action="Create" method="post" class="grid">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
          
            <div class="row row-2">
                <div>
                    <label asp-for="Name">Client / Company Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. John Smith" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="ContactDetails">Contact Details / Email</label>
                    <input asp-for="ContactDetails" class="form-control" placeholder="e.g. john.smith@email.com" required />
                    <span asp-validation-for="ContactDetails" class="text-danger"></span>
                </div>
            </div>

            <div class="row row-2">
                <div>
                    <label asp-for="Region">Operational Region</label>
                    <input asp-for="Region" class="form-control" placeholder="e.g. Gauteng" required />
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>
                <div>
                    </div>
            </div>

            <div style="display:flex; gap: 10px; align-items:center;">
                <button class="btn btn-primary" type="submit">Create Client</button>
                <a asp-action="Index" class="btn btn-ghost" style="text-decoration:none; text-align:center;">Back to List</a>
            </div>
        </form>
    </div>
</div>
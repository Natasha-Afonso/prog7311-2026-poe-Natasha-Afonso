@model IEnumerable<MedicMoveLogisticsMVC.Models.ServiceRequests>

@{
    ViewData["Title"] = "Service Requests List";
    ViewBag.UserRole = Context.Session.GetString("AccountRole");
}




<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Part2</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #E0F2F1;
        }

        .glassmorphism {
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 1rem;
            color: #4A5568;
            font-weight: 500;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .sidebar-item:hover,
            .sidebar-item.active {
                background-color: #2DD4BF;
                color: white;
            }

            .sidebar-item .material-icons {
                margin-right: 1rem;
            }






        .kanban-column {
            min-height: 300px;
        }

        .task-card {
            cursor: grab;
            transition: all 0.2s ease;
        }

            .task-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            }

            .task-card:active {
                cursor: grabbing;
            }

        .modal {
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }

        .cpu-mode-indicator {
            transition: all 0.3s ease;
        }


        /* Custom scrollbar for webkit browsers */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.5);
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(156, 163, 175, 0.8);
            }

        .dark ::-webkit-scrollbar-thumb {
            background: rgba(75, 85, 99, 0.5);
        }

            .dark ::-webkit-scrollbar-thumb:hover {
                background: rgba(75, 85, 99, 0.8);
            }

        /* Progress bars */
        .progress-bar {
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-value {
            height: 100%;
            transition: width 0.5s ease;
        }

        /* Gantt chart */
        .gantt-container {
            overflow-x: auto;
        }

        .gantt-row {
            height: 40px;
        }

        .gantt-bar {
            height: 22px;
            margin-top: 9px;
            border-radius: 3px;
            position: relative;
        }
    </style>
</head>
<div class="card tab" id="tab-jobs" role="tabpanel">
  <div class="hd">
    <h2>All Jobs</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Request</a>
  </div>
  <div class="bd">
    <div id="jobsList" class="list">
      @foreach (var item in Model) {
        <div class="list-item" style="display: flex; justify-content: space-between; align-items: center; padding: 12px; border-bottom: 1px solid var(--border); gap: 16px;">
          
          <div style="flex: 1;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span style="font-weight: 600; font-size: 14px;">#@item.Id</span>
              <strong>@item.Contract?.ContractName</strong>
              @{
                var statusClass = item.Status == "Pending" ? "bg-primary" : "bg-success";
              }
              <span class="badge @statusClass">@item.Status</span>
            </div>
            
            <div style="font-size: 13px; color: var(--muted); line-height: 1.4;">
              <span>Patient: @item.Contract?.Client?.Name</span>
              <span style="margin: 0 8px;">•</span>
              <span>@item.Description</span>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 16px;">
            <div style="font-weight: 700; font-size: 15px; text-align: right;">
              @item.Cost.ToString("C")
            </div>

            @if (ViewBag.AccountRole == "Admin" && item.Status == "Pending") {
              <div style="display: flex; gap: 8px;">
                <form asp-controller="Admin" asp-action="UpdateApprove" asp-route-id="@item.Id" method="post" style="margin: 0;">
                  <button type="submit" class="text-green-600 hover:text-green-900 hover:bg-green-50 px-3 py-1 rounded-md transition-colors" style="background: none; border: none; font-size: 13px; font-weight: 600; cursor: pointer;">Approve</button>
                </form>
                <form asp-controller="Admin" asp-action="UpdateDeny" asp-route-id="@item.Id" method="post" style="margin: 0;">
                  <button type="submit" class="text-red-600 hover:text-red-900 hover:bg-red-50 px-3 py-1 rounded-md transition-colors" style="background: none; border: none; font-size: 13px; font-weight: 600; cursor: pointer;">Deny</button>
                </form>
              </div>
            }

            @if (ViewBag.AccountRole == "Client") {
              <div style="display: flex; gap: 4px;">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
              </div>
            }
          </div>

        </div>
      }
    </div>
  </div>
</div>
@model prjHealthCareSystem.Models.ServiceRequest
@{
    ViewData["Title"] = "Create Service Request";
}

<h1>Create</h1>

<h4>Service Request</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="ContractId" class="control-label fw-bold"></label>
                
                <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId">
                    <option value="">-- Select an Active Contract --</option>
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Amount" class="control-label fw-bold">Enter Amount</label>
                 <input asp-for="Amount" class="form-control" type="number" step="0.01 " />
                  <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label" fw-bold>Convert Currency</label>
                <div class="input-group">
                <select asp-for="CurrencyFrom" class="form-select">
                    <option value="USD">USD</option>
                    <option value="JPY">JPY</option>
                    <option value="CNY">CNY</option>
                </select>
                <span class="input-group-text">to</span>
                <input class="form-control" value="ZAR" readonly />
                </div>
                </div>
             <div class="form-group mb-3">
                <label class="control-label">Converted Cost(ZAR)</label>
                <input class="form-control" value="@Model?.Cost" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" value="Pending" readonly />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create Appointment" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
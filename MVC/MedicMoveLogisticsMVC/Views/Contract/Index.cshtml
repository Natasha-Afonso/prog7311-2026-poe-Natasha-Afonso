HTML
@model IEnumerable<MedicMoveLogisticsMVC.Models.Contract>
@{
    ViewData["Title"] = "Contracts List";
    ViewBag.AccountRole = Context.Session.GetString("AccountRole");
}

<div class="card tab" id="tab-jobs" role="tabpanel">
    <div class="hd">
        <h2>Contracts</h2>
        @if (ViewBag.AccountRole == "Admin")
        {
            <a asp-action="Create" class="btn btn-primary">Create New Contract</a>
        }
    </div>
    
    <div class="bd">
        <form method="get" asp-action="Index" class="grid" style="margin-bottom: 24px;">
            <div class="row row-2">
                <div>
                    <label>Status State</label>
                    <select name="status" asp-items="ViewBag.StatusFilter" class="form-select">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                
                <div class="row row-2" style="gap: 12px; margin: 0; padding: 0;">
                    <div>
                        <label>From Date</label>
                        <input type="date" name="startTime" value="@ViewBag.StartTime" class="form-control" />
                    </div>
                    <div>
                        <label>To Date</label>
                        <input type="date" name="endDateTime" value="@ViewBag.EndDateTime" class="form-control" />
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-start; margin-top: 4px;">
                <button type="submit" class="btn btn-primary">Show Contracts</button>
            </div>
        </form>

        <div id="jobsList" class="list">
            @foreach (var item in Model)
            {
                <div class="list-item" style="display: flex; justify-content: space-between; align-items: center; padding: 12px; gap: 16px;">
                    
                    <div style="flex: 1;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <strong style="font-size: 15px;">@item.ContractName</strong>
                            @{
                                var statusClass = item.Status == "Active" ? "pill ok" : item.Status == "On Hold" ? "pill warn" : "pill bad";
                            }
                            <span class="@statusClass"><span class="dot"></span> @item.Status</span>
                            
                            <span class="pill" style="font-size: 11px;">@item.ServiceLevel</span>
                        </div>
                        
                        <div style="font-size: 13px; color: var(--muted); line-height: 1.4;">
                            <span>Client: @item.Client?.Name</span>
                            <span style="margin: 0 8px;">•</span>
                            <span>Duration: @item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()</span>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div>
                            @if (!string.IsNullOrEmpty(item.SignedConsentPath))
                            {
                                <a href="@item.SignedConsentPath" target="_blank" class="btn btn-sm btn-ghost" style="text-decoration: none; font-size: 11px; padding: 4px 8px;">View PDF</a>
                            }
                        </div>

                        @if (ViewBag.AccountRole == "Admin")
                        {
                            <div style="display: flex; gap: 4px;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-ghost" style="text-decoration: none;">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" style="text-decoration: none; padding: 8px 10px; font-size: 12px; font-weight: 700;">Delete</a>
                            </div>
                        }
                    </div>

                </div>
            }
        </div>
    </div>
</div>
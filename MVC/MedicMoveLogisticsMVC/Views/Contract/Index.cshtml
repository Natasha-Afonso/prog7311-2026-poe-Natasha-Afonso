@model IEnumerable<prjHealthCareSystem.Models.Contract>
@{
    ViewData["Title"] = "Contracts List";
    ViewBag.AccountRole = Context.Session.GetString("AccountRole");
}
<h2>Contracts</h2>
@if(ViewBag.AccountRole == "Admin") {
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Contract</a>
    </p>

<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
}
<form method="get"asp-action="Index">
 <div class="bg-white rounded-4 shadow-lg p-4 mx-auto d-flex flex-wrap gap-3 align-items-end" style="max-width:900px;">
   
  
    <div class="flex-grow-1">
     <label class="block text-xs font-bold text-gray-500 uppercase mb-1 ml-1">Status</label>
<select name="status" asp-items="ViewBag.StatusFilter" class="form-select px-3 py-2 border
 border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
    <option value="">--All Statuses</option>
</select>
 </div>
    <!--Date range filter-->
    <div class="bg-white rounded-4 shadow-lg p-4 mx-auto d-flex flex-wrap gap-3 align-items-end" style="max-width:900px;">
   
    <div class="flex-grow-1">
     <label class="block text-xs font-bold text-gray-500 uppercase mb-1 ml-1">From Date</label>
     <input type="date" name="startTime" value="@ViewBag.StartTime"
            class="form-control"/>
    </div>

<div class="flex-grow-1">
     <label class="block text-xs font-bold text-gray-500 uppercase mb-1 ml-1">To Date</label>
     <input type="date" name="endDateTime" value="@ViewBag.EndDateTime"
            class="form-control" />
 </div>


           
     <button type="submit" class="w-full md:w-auto px-6 py-2 bg-[#2DD4BF] hover:bg-teal-600 text-white font-medium rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 flex items-center justify-center gap-2">
         Show Contracts
     </button>
 </div>

</form>
  
<table class="table table-striped">
    <thead>
        <tr>
           
            <th>Contract Name</th>
            <th>Client Name</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Signed Form</th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {

        <tr>
            <td class="fw-bold">@item.ContractName</td>
            <td>@item.Client?.Name</td>
            <td>@item.StartDate.ToShortDateString()</td>
            <td>@item.EndDate.ToShortDateString()</td>
            <td><span class="badge @(item.Status == "Active" ? "bg-success" : item.Status == "On Hold" ? "bg-warning" : "bg-danger")">@item.Status</span></td>
            <td>
                @if (!string.IsNullOrEmpty(item.SignedConsentPath)) {
                    <a href="@item.SignedConsentPath" target="_blank" class="badge bg-info text-decoration-none">View PDF</a>
                }
            </td>
            <td>@item.ServiceLevel</td>

                @if (ViewBag.AccountRole == "Admin") {
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
            }
        </tr>
}
    </tbody>
</table>